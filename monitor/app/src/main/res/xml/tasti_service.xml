<?xml version="1.0" encoding="utf-8"?>
<!-- servizio che filtra il solo tasto Home (due pressioni per uscire dal monitor): non riceve eventi dello schermo -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked"
    android:packageNames="it.simulafranz.monitor.nessuno"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/doppio_home_desc" />
